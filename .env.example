# dodeed 로컬 실행용 환경변수 예시. `cp .env.example .env` 후 빈 값을 채운다.
# 비밀값이 비어 있거나 아래 조건에 맞지 않으면 서버가 시작되지 않는다.
# .env는 .gitignore에 들어 있다. 실제 키를 이 파일에 적지 않는다.

# 데이터베이스와 Redis (docker compose 기본값)
DODEED_DATABASE_URL=postgresql+asyncpg://dodeed:dodeed@localhost:5432/dodeed
DODEED_REDIS_URL=redis://localhost:6379/0

# 웹 주소 (가입 안내 링크, https면 보안 쿠키 사용)
DODEED_WEB_BASE_URL=http://localhost:8000

# 텔레그램: BotFather 토큰(8자 이상), 웹훅 비밀값(필수, 영문·숫자·_·- 만 1~256자)
DODEED_TELEGRAM_BOT_TOKEN=
DODEED_TELEGRAM_WEBHOOK_SECRET=

# 카카오 Local API (REST API 키, 8자 이상)
DODEED_KAKAO_REST_API_KEY=

# 네이버 검색 API (Client ID / Client Secret, 각각 8자 이상)
DODEED_NAVER_CLIENT_ID=
DODEED_NAVER_CLIENT_SECRET=

# 공공데이터포털 일반음식점 인허가 API (일반 인증키 Decoding, 8자 이상)
DODEED_LOCALDATA_API_KEY=

# 내부 HMAC 키 (세션 쿠키 서명, 32자 이상 임의 문자열)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
DODEED_SECRET_HMAC_KEY=

# LLM 공급자. 지금은 fake(고정 응답)만 지원한다.
DODEED_LLM=fake
